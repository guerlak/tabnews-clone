{
  "name": "tabnews-clone",
  "version": "1.0.0",
  "description": "Curso.dev Project to practice programming skills",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "build": "next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "migration:create": "node-pg-migrate create --migrations-dir ./infra/migrations",
    "migration:up": "node-pg-migrate up --migrations-dir ./infra/migrations --envPath .env.development",
    "migration:down": "node-pg-migrate down --migrations-dir ./infra/migrations --envPath .env.development",
    "migration:reset": "node-pg-migrate reset --migrations-dir ./infra/migrations --envPath .env.development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guerlak/tabnews-clone.git"
  },
  "author": "Guerlak",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/guerlak/tabnews-clone/issues"
  },
  "homepage": "https://github.com/guerlak/tabnews-clone#readme",
  "dependencies": {
    "dotenv": "^17.3.1",
    "next": "^16.1.0",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "prettier": "^3.7.4"
  }
}
